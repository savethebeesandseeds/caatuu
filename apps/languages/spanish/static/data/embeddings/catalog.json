      "component": "Transformers.js 4.2.0",
      "license": "Apache-2.0",
      "noticeUrl": "/language-runtime/vendor/transformers/LICENSE"
    },
    {
      "component": "ONNX Runtime Web 1.26.0-dev.20260416-b7804b056c",
      "license": "MIT",
      "noticeUrl": "/language-runtime/models/all-minilm-l6-v2-qint8-v0.1/runtime/THIRD_PARTY_NOTICES.json"
    }
  ],
  "notes": "MiniLM operates only on authored English embeddingText. Spanish text cannot enter the embedding boundary. The model is loaded on demand, with deterministic English lexical ranking as fallback."
