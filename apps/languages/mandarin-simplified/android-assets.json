{
  "$schema": "https://caatuu.org/schemas/android-assets.v1.schema.json",
  "schemaVersion": 1,
  "courseId": "zh",
  "nativeProviders": {
    "schemaVersion": 1,
    "providers": {
      "embeddings": {
        "implementation": "webview-english-minilm-v1",
        "resource": "embeddingCatalog"
      },
      "speech": {
        "implementation": "android-text-to-speech-v1",
        "localeSource": "targetLanguage.speechLocale"
      }
    }
  },
  "files": [
    "manifest.webmanifest",
    "setup-assets.json",
    "source/language/adapter.mjs",
    "source/shared/course-profile.js",
    "sw.js",
    "data/embeddings/catalog.json",
    "data/games/naturalization-nucleus/challenges.json",
    "data/games/verb-nebula/core-vocabulary.json",
    "data/games/word-world/manifest.json",
    "data/games/word-world/starter-v1.realizations.json",
    "data/games/word-world/starter-v1.reading-guides.json",
    "source/games/naturalization-nucleus/naturalization-nucleus.css",
    "source/games/naturalization-nucleus/naturalization-nucleus.js"
  ],
  "launcherIconFiles": [
    "china_flag.png"
  ],
  "policy": {
    "includeOnlyAllowlistedFiles": true,
    "llmAssetsAllowed": false,
    "targetPronunciationMetadataAllowed": true
  }
}
