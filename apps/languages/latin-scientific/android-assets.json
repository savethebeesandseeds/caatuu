{
  "$schema": "https://caatuu.org/schemas/android-assets.v1.schema.json",
  "schemaVersion": 1,
  "courseId": "la",
  "nativeProviders": {
    "schemaVersion": 1,
    "providers": {
      "embeddings": {
        "implementation": "webview-english-minilm-v1",
        "resource": "embeddingCatalog"
      }
    }
  },
  "files": [
    "manifest.webmanifest",
    "setup-assets.json",
    "source/language/adapter.mjs",
    "source/shared/course-profile.js",
    "sw.js",
    "data/embeddings/catalog.json",
    "data/games/verb-nebula/content.json",
    "data/games/word-world/manifest.json",
    "data/games/word-world/content.json",
    "data/games/conjugation-comet/content.json",
    "data/games/grammar-gravity/content.json",
    "data/games/grammar-gravity/nouns.json"
  ],
  "launcherIconFiles": [],
  "policy": {
    "includeOnlyAllowlistedFiles": true,
    "llmAssetsAllowed": false,
    "targetPronunciationMetadataAllowed": false
  }
}
