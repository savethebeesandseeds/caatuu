      "revision": "conjugation-comet-content-1"
    },
    "grammarGravityCatalog": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/games/grammar-gravity/content.json",
      "scope": "course",
      "state": "present",
      "revision": "grammar-gravity-content-1"
    },
    "grammarGravityNouns": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/games/grammar-gravity/nouns.json",
      "scope": "course",
      "state": "present",
      "revision": "grammar-gravity-nouns-1"
    },
    "launcherFlag": {
      "kind": "file",
      "path": "apps/language-runtime/static/assets/home/norway_flag.png",
      "scope": "shared",
      "state": "present"
    }
  }
}
