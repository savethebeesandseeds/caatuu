      "path": "apps/languages/norwegian-bokmal/static/manifest.webmanifest",
      "scope": "course",
      "state": "present"
    },
    "setupCatalog": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/setup-assets.json",
