      "scope": "course",
      "state": "present"
    },
    "languageAdapter": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/source/language/adapter.mjs",
      "scope": "course",
      "state": "present"
    },
    "webManifest": {
