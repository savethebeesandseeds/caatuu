      "state": "present"
    },
    "sourceLanguageFlag": {
      "kind": "file",
      "path": "apps/language-runtime/static/assets/home/english_flag.png",
      "scope": "shared",
      "state": "present"
    },
    "embeddingCatalog": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/embeddings/catalog.json",
      "scope": "course",
      "state": "present"
    },
    "wordWorldManifest": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/games/word-world/manifest.json",
      "scope": "course",
      "state": "present",
      "revision": "word-world-content-1"
    },
    "verbNebulaCatalog": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/games/verb-nebula/content.json",
      "scope": "course",
      "state": "present"
    },
    "conjugationCometCatalog": {
      "kind": "file",
      "path": "apps/languages/norwegian-bokmal/static/data/games/conjugation-comet/content.json",
      "scope": "course",
