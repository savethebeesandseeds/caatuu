    },
    "grammarGravityCatalog": {
      "kind": "file",
      "path": "apps/languages/english-from-spanish/static/data/games/grammar-gravity/content.json",
      "scope": "course",
      "state": "present",
      "revision": "grammar-gravity-content-2"
    },
    "grammarGravityNouns": {
      "kind": "file",
      "path": "apps/languages/english-from-spanish/static/data/games/grammar-gravity/nouns.json",
      "scope": "course",
      "state": "present",
      "revision": "grammar-gravity-nouns-3"
    },
    "launcherFlag": {
      "kind": "file",
      "path": "apps/language-runtime/static/assets/home/english_flag.png",
      "scope": "shared",
      "state": "present"
    }
  }
}
