      "state": "present",
      "revision": "interface-es-6"
    },
    "courseProfile": {
      "kind": "file",
      "path": "apps/languages/english-from-spanish/static/source/shared/course-profile.js",
      "scope": "course",
      "state": "present"
    },
    "languageAdapter": {
      "kind": "file",
      "path": "apps/languages/english-from-spanish/static/source/language/adapter.mjs",
      "scope": "course",
      "state": "present"
    },
    "webManifest": {
