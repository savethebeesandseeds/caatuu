      "path": "apps/languages/english-from-spanish/static/manifest.webmanifest",
      "scope": "course",
      "state": "present"
    },
    "setupCatalog": {
      "kind": "file",
      "path": "apps/languages/english-from-spanish/static/setup-assets.json",
      "scope": "course",
      "state": "present"
    },
    "sourceLanguageFlag": {
