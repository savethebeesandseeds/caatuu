{
  "$schema": "../../../tools/language-packs/schemas/course-pack.v1.schema.json",
  "schemaVersion": 1,
  "id": "es-en",
  "directoryName": "english-from-spanish",
  "status": "development",
  "brandLabel": "Caatuu",
  "workspaceLabel": "Caatuu Inglés",
  "routePrefix": "/es-en",
  "entryPath": "/es-en/index.html",
  "sourceLanguage": {
    "id": "es",
    "label": "Spanish",
    "nativeLabel": "Español",
    "shortCode": "ES",
    "locale": "es-ES",
    "direction": "ltr",
    "flagClass": "spain-flag",
    "flagSrc": "/assets/icons/spain_flag.png"
  },
  "targetLanguage": {
    "id": "en",
    "label": "English",
    "nativeLabel": "English",
    "shortCode": "EN",
    "locale": "en-US",
    "script": "Latn",
    "speechLocale": "en-US",
    "direction": "ltr",
    "flagClass": "en-flag",
    "flagSrc": "/assets/icons/english_flag.png"
  },
  "linguisticFeatures": [
    "verb-conjugation",
    "grammatical-agreement"
  ],
  "games": [
    "verb-lab",
    "word-net",
    "conjugation-comet",
    "grammar-gravity",
    "sound-quasar"
  ],
  "upcomingGames": [],
  "launcher": {
    "flagClass": "flag-icon"
  },
  "routes": {
    "soundQuasar": "/language-runtime/static/games/sound-quasar.html",
    "languageSelection": "/",
    "home": "index.html",
    "games": "index.html",
    "verbNebula": "index.html?game=verb-lab",
    "wordWorld": "index.html?game=word-net",
    "conjugationComet": "/language-runtime/static/games/conjugation-comet.html",
    "grammarGravity": "/language-runtime/static/games/grammar-gravity.html",
    "settings": "index.html"
  },
  "storage": {
    "namespace": "caatuu-es-en",
    "theme": "caatuu-es-en.theme",
    "fontSize": "caatuu-es-en.font-size",
    "learningPreferences": "caatuu-es-en.learning.preferences.v1",
    "learningPerformance": "caatuu-es-en.learning.performance.v1",
    "semanticLearningDatabase": "caatuu-es-en.semantic-learning",
    "verbMemory": "caatuu-es-en.verb-memory.v3",
    "wordWorldTranslationMode": "caatuu-es-en.word-world.translation-mode",
    "wordWorldRecentSentences": "caatuu-es-en.word-world.recent-sentences.v1"
  },
  "cache": {
    "prefix": "caatuu-es-en-pwa-",
    "setupFallback": "caatuu-es-en-setup-v1"
  },
  "publication": {
    "contract": "language-content-v1",
    "concepts": "apps/languages/shared/english-concepts/word-world-es-en-v1.json",
    "realizations": "apps/languages/english-from-spanish/content/word-world/starter-v1.realizations.json",
    "learnerBaseRealizations": "apps/languages/shared/learner-base-realizations/es-ES/word-world-starter-v1.json",
    "runtimeProjection": {
      "policyId": "english-american-word-world-v1",
      "conceptsRuntime": "apps/language-runtime/static/data/english-concepts/word-world-es-en-v1.json",
      "targetRealizationsRuntime": "apps/languages/english-from-spanish/static/data/games/word-world/content.json",
      "learnerBaseRuntime": "apps/languages/english-from-spanish/static/data/games/word-world/learner-base.json",
      "supplementalOutputs": {},
      "manifest": "apps/languages/english-from-spanish/static/data/games/word-world/manifest.json"
    }
  },
  "capabilities": {
    "llm": false,
    "generation": false,
    "chat": false,
    "embeddings": true,
    "semanticSearch": true,
    "dictionary": false,
    "memory": false,
    "verbs": false,
    "wordWorld": true,
    "conjugationComet": true,
    "offlineModels": false,
    "speech": true,
    "pronunciationGuides": false
  },
  "learningGoals": [
    {
      "id": "people-social",
      "label": "Personas y conversaciones",
      "embeddingText": "Greet people, introduce family and friends, ask questions and share everyday experiences.",
      "categories": ["people", "family-people", "identity", "identity-people-family", "first-contact", "greetings", "greetings-social", "conversation-questions", "friendship", "communication", "community-politeness", "experience-opinion"]
    },
    {
      "id": "home-routines",
      "label": "Hogar y vida cotidiana",
      "embeddingText": "Describe home, clothing, household objects and everyday routines.",
      "categories": ["home", "home-objects-location", "routines-home", "objects", "adult-housing", "daily-life", "clothes"]
    },
    {
      "id": "food-shopping",
      "label": "Comida, bebidas y compras",
      "embeddingText": "Talk about food and drinks, order a meal and shop for everyday needs.",
      "categories": ["food", "food-and-drink", "food-drink", "shopping-services"]
    },
    {
      "id": "school-work",
      "label": "Escuela, trabajo y tecnología",
      "embeddingText": "Study at school, discuss science and mathematics, work with others and organize tasks using technology.",
      "categories": ["school", "school-learning", "classroom-language", "science", "math", "work-tasks", "work-collaboration", "digital-organization", "technology-communication"]
    },
    {
      "id": "travel-services",
      "label": "Viajes, lugares y servicios",
      "embeddingText": "Find places, plan travel, use transport and ask for practical services.",
      "categories": ["locations", "travel", "transit-travel", "travel-logistics", "objects-location-services", "adult-services"]
    },
    {
      "id": "nature-weather",
      "label": "Animales, naturaleza y clima",
      "embeddingText": "Describe animals, nature and the weather, and discuss caring for the environment.",
      "categories": ["animals", "nature", "nature-animals", "weather", "weather-routine", "environment-community"]
    },
    {
      "id": "plans-time",
      "label": "Tiempo, planes y explicaciones",
      "embeddingText": "Discuss time, make plans, compare choices, explain reasons and solve everyday problems.",
      "categories": ["numbers-time", "planning", "plans", "plans-comparison", "problems-plans", "daily-problem-solving", "reasoning", "connected-reasoning"]
    },
    {
      "id": "creativity-play",
      "label": "Juego, arte e imaginación",
      "embeddingText": "Talk about play, art, music, creative ideas and imaginary stories.",
      "categories": ["play", "art", "music", "creativity", "imagination"]
    }
  ],
  "platforms": {
    "browser": {
      "enabled": true,
      "pagesEnabled": true,
      "entryPath": "/es-en/index.html",
      "backend": "static"
    },
    "android": {
      "enabled": true,
      "channels": [
        {
          "kind": "release",
          "manifest": "/android/caatuu.json",
          "artifact": "/android/caatuu.apk",
          "minimumVersionCode": 168
        },
        {
          "kind": "preview",
          "manifest": "/android/caatuu-preview.json",
          "artifact": "/android/caatuu-preview.apk",
          "minimumVersionCode": 168
        }
      ]
    }
  },
