{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/runtime/english-concepts.runtime.v1.schema.json",
  "title": "Caatuu browser English concept projection v1",
  "description": "A narrow public runtime projection of an authored English concept catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "language",
    "derivedFrom",
    "embeddingPolicy",
    "license",
    "concepts"
  ],
  "properties": {
    "$schema": { "const": "https://caatuu.org/schemas/runtime/english-concepts.runtime.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[1-9][0-9]*$" },
    "language": { "const": "en" },
    "derivedFrom": {
      "type": "string",
      "pattern": "^apps/languages/shared/english-concepts/[a-z0-9][a-z0-9.-]*\\.json$"
    },
    "embeddingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputLanguage", "inputField", "targetTextAllowed"],
      "properties": {
        "inputLanguage": { "const": "en" },
        "inputField": { "const": "embeddingText" },
        "targetTextAllowed": { "const": false }
      }
    },
    "license": { "$ref": "#/$defs/licenseGate" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "englishText", "embeddingText", "sceneQuery", "topic", "difficulty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "englishText": { "$ref": "#/$defs/nonEmptyString" },
        "embeddingText": { "$ref": "#/$defs/nonEmptyString" },
        "sceneQuery": { "$ref": "#/$defs/nonEmptyString" },
        "topic": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "licenseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "status", "spdxExpression", "sourceReference", "reviewedBy", "reviewedAt"],
      "properties": {
        "origin": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["release-review-required", "release-cleared"] },
        "spdxExpression": { "type": ["string", "null"] },
        "sourceReference": { "type": ["string", "null"] },
        "reviewedBy": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
