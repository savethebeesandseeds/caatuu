{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.local/schemas/game-manifest.v2.schema.json",
  "title": "Caatuu game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "manifest_version",
    "id",
    "version",
    "release_status",
    "interface_locales",
    "engine",
    "source",
    "delivery",
    "platforms",
    "browser_mode",
    "dependencies",
    "notices",
    "commands"
  ],
  "properties": {
    "schema_name": {
      "const": "caatuu-game-manifest"
    },
    "schema_version": {
      "const": 2
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release_status": {
      "enum": [
        "local-preview-only",
        "release-candidate",
        "released"
      ]
    },
    "interface_locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "platforms": {
      "$ref": "#/$defs/platforms"
    },
    "browser_mode": {
      "enum": [
        "standalone",
        "embedded"
      ]
    },
    "host_contract": {
      "$ref": "#/$defs/hostContract"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "notices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safeRelativePath"
      }
    },
    "commands": {
      "$ref": "#/$defs/commands"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_status": {
            "enum": [
              "release-candidate",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "dependencies": {
            "items": {
              "properties": {
                "status": {
                  "const": "active"
                }
              }
            }
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "browser_mode": {
          "const": "standalone"
        },
        "host_contract": false
      }
    },
    {
      "required": [
        "host_contract"
      ],
      "properties": {
        "browser_mode": {
          "const": "embedded"
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "safeAbsolutePath": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "renderer",
        "export_preset",
        "threading"
      ],
      "properties": {
        "name": {
          "const": "godot"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "renderer": {
          "const": "gl_compatibility"
        },
        "export_preset": {
          "type": "string",
          "minLength": 1
        },
        "threading": {
          "enum": [
            "single",
            "multi"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/safeRelativePath"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_directory",
        "public_entrypoint",
        "compatibility_entrypoints"
      ],
      "properties": {
        "artifact_directory": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "public_entrypoint": {
          "$ref": "#/$defs/safeAbsolutePath"
        },
        "compatibility_entrypoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeAbsolutePath"
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "android"
      ],
      "properties": {
        "browser": {
          "type": "boolean"
        },
        "android": {
          "type": "boolean"
        }
      }
    },
    "hostContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_source",
        "ready_event",
        "same_origin"
      ],
      "properties": {
        "message_source": {
          "$ref": "#/$defs/slug"
        },
        "ready_event": {
          "$ref": "#/$defs/slug"
        },
        "same_origin": {
          "const": true
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "authority": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "status": {
          "enum": [
            "active",
            "preview-only",
            "blocked",
            "retired"
          ]
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export",
        "validate"
      ],
      "properties": {
        "export": {
          "type": "string",
          "minLength": 1
        },
        "validate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
