{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.local/schemas/language-game-adapter.v1.schema.json",
  "title": "Caatuu language game adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "adapter_version",
    "scope",
    "language_id",
    "target_locale",
    "game_id",
    "presentation",
    "placement",
    "enabled_platforms",
    "curriculum_bindings"
  ],
  "properties": {
    "schema_name": {
      "const": "caatuu-language-game-adapter"
    },
    "schema_version": {
      "const": 1
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "const": "host-presentation-only"
    },
    "language_id": {
      "$ref": "#/$defs/slug"
    },
    "target_locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "game_id": {
      "$ref": "#/$defs/slug"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "enabled_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "browser",
          "android"
        ]
      }
    },
    "curriculum_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^binding\\.[a-z0-9][a-z0-9.-]*$"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "safeAbsoluteAssetPath": {
      "type": "string",
      "pattern": "^/assets/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "loading_text",
        "icon"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "loading_text": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/safeAbsoluteAssetPath"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "order"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/slug"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
