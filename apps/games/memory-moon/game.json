{
  "schema_name": "caatuu-game-manifest",
  "schema_version": 1,
  "manifest_version": "1.0.0",
  "id": "memory-moon",
  "version": "0.1.0",
  "release_status": "local-preview-only",
  "interface_locales": [
    "en"
  ],
  "engine": {
    "name": "godot",
    "version": "4.7.1",
    "renderer": "gl_compatibility",
    "export_preset": "Web",
    "threading": "single"
  },
  "source": {
    "project": "apps/games/memory-moon/project.godot"
  },
  "delivery": {
    "artifact_directory": "artifacts/games/memory-moon/web/godot-v1",
    "public_entrypoint": "/games/memory-moon/godot-v1/index.html",
    "compatibility_entrypoints": [
      "/cz/games/memory-moon/godot-v1/index.html"
    ]
  },
  "platforms": {
    "browser": true,
    "android": true
  },
  "host_contract": {
    "message_source": "caatuu-memory-moon",
    "ready_event": "ready",
    "same_origin": true
  },
  "dependencies": [
    {
      "id": "memory-moon-scenery",
      "authority": "apps/launcher/static/assets/scenery/metadata/registry.json",
      "status": "preview-only"
    },
    {
      "id": "quaternius-universal-animation-library-standard-v1",
      "authority": "apps/launcher/static/assets/motion/quaternius-standard-v1/manifest.json",
      "status": "preview-only"
    },
    {
      "id": "macaw-traveler-v1",
      "authority": "apps/animated-fabric/assets/reference-packages/macaw-traveler-v1/reference.json",
      "status": "active"
    }
  ],
  "notices": [
    "apps/games/memory-moon/THIRD_PARTY_NOTICES.md"
  ],
  "commands": {
    "export": "docker compose --profile game-tools run --rm memory-moon-godot-export",
    "validate": "node apps/games/test/game-catalog-contract.test.mjs"
  }
}
