{
  "schemaVersion": "caatuu-conformance-mutation-v1",
  "description": "A new context ID cannot manufacture diversity when features and opportunities are identical.",
  "mutations": [
    {
      "op": "replace",
      "path": "/contexts/1/featureValues",
      "value": {"interlocutor-role": "peer", "register": "informal"}
    },
    {
      "op": "replace",
      "path": "/contexts/1/opportunities",
      "value": [
        {
          "id": "greet-peer",
          "operation": "produce",
          "targetSkillIds": ["cs.skill.function.greet"],
          "stimulusUtteranceIds": [],
          "expectedUtteranceIds": ["cs.utterance.ahoj"]
        },
        {
          "id": "identify-peer",
          "operation": "produce",
          "targetSkillIds": ["cs.skill.function.identify-self"],
          "stimulusUtteranceIds": [],
          "expectedUtteranceIds": ["cs.utterance.jmenuji-se-anna"]
        }
      ]
    }
  ],
  "expectedErrorCodes": ["CURR_COVERAGE_INSUFFICIENT"]
}
