{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schema/cross-game-learning-evidence-event-v1.json",
  "title": "Caatuu immutable cross-game learning evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "occurredAt",
    "taskId",
    "taskFingerprint",
    "sessionId",
    "taskSequence",
    "attemptNumber",
    "registry",
    "bindingId",
    "capabilityId",
    "activityId",
    "mechanicId",
    "contentRef",
    "canonicalUnitId",
    "canonicalUnitRevision",
    "targetSkillId",
    "targetSkillRevision",
    "contextId",
    "contextRevision",
    "opportunityId",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {"const": "caatuu-cross-game-learning-evidence-v1"},
    "eventId": {"type": "string", "minLength": 8, "maxLength": 200},
    "occurredAt": {"type": "string", "format": "date-time"},
    "taskId": {"type": "string", "minLength": 8, "maxLength": 200},
    "taskFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sessionId": {"type": "string", "minLength": 1, "maxLength": 160},
    "taskSequence": {"type": "integer", "minimum": 1},
    "attemptNumber": {"type": "integer", "minimum": 1},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "bindingId": {"type": "string", "pattern": "^binding\\."},
    "capabilityId": {"type": "string", "minLength": 3},
    "activityId": {"enum": ["word-world", "verb-nebula", "conjugation-comet"]},
    "mechanicId": {"type": "string", "minLength": 3},
    "contentRef": {"$ref": "cross-game-binding-registry-v1.json#/$defs/contentRef"},
    "canonicalUnitId": {"type": "string", "pattern": "^unit\\."},
    "canonicalUnitRevision": {"type": "integer", "minimum": 1},
    "targetSkillId": {"type": "string", "minLength": 3},
    "targetSkillRevision": {"type": "integer", "minimum": 1},
    "contextId": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z]{2,3}\\.context\\."},
        {"type": "null"}
      ]
    },
    "contextRevision": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "opportunityId": {
      "oneOf": [
        {"type": "string", "minLength": 3},
        {"type": "null"}
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "solutionRevealed", "hintsUsed"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "solutionRevealed": {"type": "boolean"},
        "hintsUsed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
