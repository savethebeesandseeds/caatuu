{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schema/canonical-curriculum-v1.json",
  "title": "Caatuu canonical English-authored curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "curriculumId",
    "version",
    "specLocale",
    "title",
    "description",
    "planningPolicy",
    "learningStageSequence",
    "semanticDefinitions",
    "unitOrder",
    "units"
  ],
  "properties": {
    "schemaVersion": {"const": "caatuu-canonical-curriculum-v1"},
    "curriculumId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "specLocale": {"const": "en"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "planningPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxNewSemanticConceptsPerSession",
        "maxNewTargetConstructionsPerSession",
        "repairRetryTaskGap",
        "delayedRetrievalMinimumSessionGap",
        "exposureCanQualifyForMastery",
        "solutionRevealCanQualifyForMastery"
      ],
      "properties": {
        "maxNewSemanticConceptsPerSession": {"type": "integer", "minimum": 0},
        "maxNewTargetConstructionsPerSession": {"type": "integer", "minimum": 0},
        "repairRetryTaskGap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          }
        },
        "delayedRetrievalMinimumSessionGap": {"type": "integer", "minimum": 1},
        "exposureCanQualifyForMastery": {"const": false},
        "solutionRevealCanQualifyForMastery": {"const": false}
      }
    },
    "learningStageSequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/learningStage"}
    },
    "semanticDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/semanticDefinition"}
    },
    "unitOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^unit\\."}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "ordinal",
        "title",
        "description",
        "canDo",
        "semanticScope",
        "transferPolicy",
        "prerequisiteUnitIds",
        "requiredLearningStages",
        "masteryPolicy"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^unit\\."},
        "revision": {"type": "integer", "minimum": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "canDo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observableOutcome"],
          "properties": {
            "observableOutcome": {"type": "string", "minLength": 1}
          }
        },
        "semanticScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functionIds", "frameIds", "conceptIds"],
          "properties": {
            "functionIds": {"$ref": "#/$defs/nonEmptyUniqueIds"},
            "frameIds": {"$ref": "#/$defs/nonEmptyUniqueIds"},
            "conceptIds": {"$ref": "#/$defs/nonEmptyUniqueIds"}
          }
        },
        "transferPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredContextDimensions", "minimumNovelDimensionsPerTransfer"],
          "properties": {
            "requiredContextDimensions": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/contextDimension"}
            },
            "minimumNovelDimensionsPerTransfer": {"type": "integer", "minimum": 1}
          }
        },
        "prerequisiteUnitIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^unit\\."}
        },
        "requiredLearningStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/learningStage"}
        },
        "masteryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumIndependentRetrievals",
            "minimumSessions",
            "minimumDistinctContexts",
            "scope",
            "requiresTransfer",
            "requiresProduction",
            "solutionRevealCanQualify",
            "unresolvedRecentFailureBlocksMastery"
          ],
          "properties": {
            "minimumIndependentRetrievals": {"type": "integer", "minimum": 1},
            "minimumSessions": {"type": "integer", "minimum": 1},
            "minimumDistinctContexts": {"type": "integer", "minimum": 1},
            "scope": {"const": "each-required-target-skill"},
            "requiresTransfer": {"type": "boolean"},
            "requiresProduction": {"type": "boolean"},
            "solutionRevealCanQualify": {"const": false},
            "unresolvedRecentFailureBlocksMastery": {"const": true}
          }
        }
      }
    },
    "learningStage": {
      "enum": [
        "encounter",
        "comprehend",
        "discriminate",
        "retrieve",
        "supported-produce",
        "interact",
        "transfer",
        "delayed-retrieval"
      ]
    },
    "semanticDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "kind", "definitionEn"],
      "properties": {
        "id": {"type": "string", "pattern": "^(function|frame|concept)\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["function", "frame", "concept"]},
        "definitionEn": {"type": "string", "minLength": 1},
        "requiredEvidenceMode": {"enum": ["comprehension", "production", "interaction"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "function"}}},
          "then": {"required": ["requiredEvidenceMode"]},
          "else": {"not": {"required": ["requiredEvidenceMode"]}}
        }
      ]
    },
    "contextDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionEn", "minimumDistinctValuesPerSkill"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "definitionEn": {"type": "string", "minLength": 1},
        "minimumDistinctValuesPerSkill": {"type": "integer", "minimum": 2}
      }
    },
    "nonEmptyUniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    }
  }
}
