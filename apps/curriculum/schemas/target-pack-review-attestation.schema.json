{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schema/target-pack-review-attestation-v1.json",
  "title": "Caatuu target-pack teacher review attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attestationId",
    "curriculum",
    "targetPack",
    "reviewer",
    "reviewedAt",
    "checklistVersion",
    "decisions",
    "notesEn"
  ],
  "properties": {
    "schemaVersion": {"const": "caatuu-target-pack-review-attestation-v1"},
    "attestationId": {"type": "string", "pattern": "^attestation\\.[a-z0-9.-]+$"},
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "canonicalContractDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonicalContractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "targetPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "targetLocale", "targetPackDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "targetLocale": {"type": "string", "minLength": 2},
        "targetPackDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerId", "role", "qualifiedTargetLocales"],
      "properties": {
        "reviewerId": {"type": "string", "minLength": 3},
        "role": {"const": "native-language-educator"},
        "qualifiedTargetLocales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "reviewedAt": {"type": "string", "format": "date-time"},
    "checklistVersion": {"const": "caatuu-target-language-teacher-review-v1"},
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticEquivalence",
        "naturalness",
        "pragmatics",
        "morphology",
        "ageSafety",
        "contextValidity",
        "opportunityValidity",
        "mediaValidity"
      ],
      "properties": {
        "semanticEquivalence": {"const": "approved"},
        "naturalness": {"const": "approved"},
        "pragmatics": {"const": "approved"},
        "morphology": {"const": "approved"},
        "ageSafety": {"const": "approved"},
        "contextValidity": {"const": "approved"},
        "opportunityValidity": {"const": "approved"},
        "mediaValidity": {"const": "approved"}
      }
    },
    "notesEn": {"type": "string"}
  }
}
