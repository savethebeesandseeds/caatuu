{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schema/morphology-developer-pilot-v1.json",
  "title": "Caatuu target-language morphology developer-pilot catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "version", "targetLocale", "review", "families", "items", "cues", "metadata"],
  "properties": {
    "schemaVersion": {"const": "caatuu-morphology-developer-pilot-v1"},
    "catalogId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "targetLocale": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "review": {"$ref": "#/$defs/review"},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/item"}
    },
    "cues": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/cue"}
    },
    "metadata": {"$ref": "#/$defs/catalogMetadata"}
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "lemmaRef", "review", "metadata"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.morphology\\.family\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "lemmaRef": {"$ref": "#/$defs/lexemeRef"},
        "review": {"$ref": "#/$defs/review"},
        "metadata": {"$ref": "#/$defs/familyMetadata"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "revision", "familyRef", "surface", "acceptedVariants", "featureKey",
        "features", "ambiguity", "review", "metadata"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.form\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "familyRef": {"$ref": "#/$defs/familyRef"},
        "surface": {"type": "string", "minLength": 1},
        "acceptedVariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "featureKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "features": {"$ref": "#/$defs/targetFeatureMap"},
        "ambiguity": {"$ref": "#/$defs/ambiguity"},
        "review": {"$ref": "#/$defs/review"},
        "metadata": {"$ref": "#/$defs/itemMetadata"}
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "revision", "familyRef", "targetItemRef", "key", "presentation",
        "ambiguityResolutionKey", "review", "metadata"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.cue\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "familyRef": {"$ref": "#/$defs/familyRef"},
        "targetItemRef": {"$ref": "#/$defs/formRef"},
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleTokenEn",
            "contextEn",
            "naturalTranslationEn",
            "teachingLabelEn",
            "hintEn",
            "solutionExplanationEn"
          ],
          "properties": {
            "roleTokenEn": {"type": "string", "minLength": 1},
            "contextEn": {"type": "string", "minLength": 1},
            "naturalTranslationEn": {"type": "string", "minLength": 1},
            "teachingLabelEn": {"type": "string", "minLength": 1},
            "hintEn": {"type": "string", "minLength": 1},
            "solutionExplanationEn": {"type": "string", "minLength": 1}
          }
        },
        "ambiguityResolutionKey": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "review": {"$ref": "#/$defs/review"},
        "metadata": {"$ref": "#/$defs/cueMetadata"}
      }
    },
    "catalogMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specLocale", "stableContentId", "stableContentSequence", "exerciseFamilyId", "releasePolicy", "curriculum", "targetPack", "mechanicCatalog"
      ],
      "properties": {
        "specLocale": {"const": "en"},
        "stableContentId": {"type": "string", "pattern": "^[a-z]{2,3}\\.morphology\\.[a-z0-9.-]+$"},
        "stableContentSequence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "orderedContentIds", "orderedCueRefs", "orderedExerciseRefs"],
          "properties": {
            "id": {"type": "string", "pattern": "^sequence\\.[a-z0-9.-]+$"},
            "revision": {"type": "integer", "minimum": 1},
            "orderedContentIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z]{2,3}\\.morphology\\.[a-z0-9.-]+$"}
            },
            "orderedCueRefs": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/cueRef"}
            },
            "orderedExerciseRefs": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/exerciseRef"}
            }
          }
        },
        "exerciseFamilyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "releasePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requiresNewCatalogForRelease", "reasonEn"],
          "properties": {
            "status": {"const": "developer-only"},
            "requiresNewCatalogForRelease": {"const": true},
            "reasonEn": {"type": "string", "minLength": 1}
          }
        },
        "curriculum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "canonicalContractDigest"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "canonicalContractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "targetPack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "targetLocale", "targetPackDigest"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "targetLocale": {"type": "string", "minLength": 2},
            "targetPackDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "mechanicCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": {"type": "string", "minLength": 3},
            "version": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "familyMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lemmaTarget", "glossEn", "exerciseFamilyId", "capabilityRef", "targetSkillRef",
        "unitRef", "senseRef", "canonicalSemanticRefs", "difficulty", "register",
        "prerequisiteRefs", "provenance", "review"
      ],
      "properties": {
        "lemmaTarget": {"type": "string", "minLength": 1},
        "glossEn": {"type": "string", "minLength": 1},
        "exerciseFamilyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "capabilityRef": {"$ref": "#/$defs/capabilityRef"},
        "targetSkillRef": {"$ref": "#/$defs/targetSkillRef"},
        "unitRef": {"$ref": "#/$defs/unitRef"},
        "senseRef": {"$ref": "#/$defs/senseRef"},
        "canonicalSemanticRefs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/canonicalSemanticRef"}
        },
        "register": {"$ref": "#/$defs/register"},
        "prerequisiteRefs": {"$ref": "#/$defs/prerequisiteRefs"},
        "difficulty": {"$ref": "#/$defs/difficulty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "itemMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lexemeRef", "senseRef", "formRef", "unitRef", "realizationType", "normalization",
        "variantRecords", "register", "prerequisiteRefs", "difficulty", "provenance", "review"
      ],
      "properties": {
        "lexemeRef": {"$ref": "#/$defs/lexemeRef"},
        "senseRef": {"$ref": "#/$defs/senseRef"},
        "formRef": {"$ref": "#/$defs/formRef"},
        "unitRef": {"$ref": "#/$defs/unitRef"},
        "realizationType": {"enum": ["synthetic", "analytic", "periphrastic", "zero"]},
        "normalization": {"const": "NFC"},
        "variantRecords": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variantRecord"}
        },
        "ambiguityRationaleEn": {"type": "string", "minLength": 1},
        "register": {"$ref": "#/$defs/register"},
        "prerequisiteRefs": {"$ref": "#/$defs/prerequisiteRefs"},
        "difficulty": {"$ref": "#/$defs/difficulty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "cueMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise", "senseRef", "unitRef", "canonicalFeatureValues", "targetFeatureConstraints",
        "targetSkillRef", "register", "prerequisiteRefs", "difficulty", "provenance", "review"
      ],
      "properties": {
        "exercise": {"$ref": "#/$defs/exerciseMetadata"},
        "senseRef": {"$ref": "#/$defs/senseRef"},
        "unitRef": {"$ref": "#/$defs/unitRef"},
        "canonicalFeatureValues": {"$ref": "#/$defs/canonicalFeatureMap"},
        "targetFeatureConstraints": {"$ref": "#/$defs/targetFeatureMap"},
        "targetSkillRef": {"$ref": "#/$defs/targetSkillRef"},
        "register": {"$ref": "#/$defs/register"},
        "prerequisiteRefs": {"$ref": "#/$defs/prerequisiteRefs"},
        "difficulty": {"$ref": "#/$defs/difficulty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "exerciseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "revision", "exerciseFamilyId", "capabilityRef", "challenge",
        "prerequisiteRefs", "review"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.exercise\\."},
        "revision": {"type": "integer", "minimum": 1},
        "exerciseFamilyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "capabilityRef": {"$ref": "#/$defs/capabilityRef"},
        "challenge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionCount", "optionsVisible", "distractorPolicy", "timePressure"],
          "properties": {
            "optionCount": {"type": "integer", "minimum": 2},
            "optionsVisible": {"const": true},
            "distractorPolicy": {"const": "same-family-feature-contrast"},
            "timePressure": {"const": false}
          }
        },
        "prerequisiteRefs": {"$ref": "#/$defs/prerequisiteRefs"},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "variantRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "surface", "acceptance", "register"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.variant\\."},
        "revision": {"type": "integer", "minimum": 1},
        "surface": {"type": "string", "minLength": 1},
        "acceptance": {"enum": ["preferred", "accepted"]},
        "register": {"$ref": "#/$defs/register"}
      }
    },
    "ambiguity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "resolutionKey"],
          "properties": {
            "mode": {"const": "cue-resolved"},
            "resolutionKey": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "cueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.cue\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "exerciseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.exercise\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "familyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.morphology\\.family\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "lexemeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.lexeme\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "senseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.sense\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "formRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.form\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "unitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^unit\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^capability\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "canonicalSemanticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^(function|frame|concept)\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "targetSkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2,3}\\.skill\\."},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "prerequisiteRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "id", "revision"],
        "properties": {
          "entityType": {"enum": ["lexeme", "sense", "form", "cue", "exercise"]},
          "id": {"type": "string", "minLength": 3},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "targetFeatureMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
      "additionalProperties": {
        "oneOf": [
          {"type": ["string", "number", "boolean"]},
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": ["string", "number", "boolean"]}
          }
        ]
      }
    },
    "canonicalFeatureMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]+$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "register": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "level", "rationaleEn", "advisoryOnly"],
      "properties": {
        "dimension": {"enum": ["lexical-familiarity", "realization-complexity", "task-challenge"]},
        "level": {"type": "integer", "minimum": 1, "maximum": 5},
        "rationaleEn": {"type": "string", "minLength": 1},
        "advisoryOnly": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId", "sourceRevision", "licenseId", "attributionEn", "transformationEn"],
      "properties": {
        "sourceType": {"enum": ["authored", "derived", "imported"]},
        "sourceId": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "string", "minLength": 1},
        "licenseId": {"type": "string", "minLength": 1},
        "attributionEn": {"type": "string", "minLength": 1},
        "transformationEn": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["prototype-not-human-approved", "human-approved", "rejected"]},
        "notesEn": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
