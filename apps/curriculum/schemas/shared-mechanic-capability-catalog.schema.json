{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schema/shared-mechanic-capability-catalog-v1.json",
  "title": "Caatuu English-owned shared mechanic capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "version",
    "specLocale",
    "authority",
    "capabilityFamilies",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {"const": "caatuu-shared-mechanic-capability-catalog-v1"},
    "catalogId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "specLocale": {"const": "en"},
    "authority": {"const": "english-authored-shared-contract"},
    "capabilityFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capabilityFamily"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capabilityFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "definitionEn"],
      "properties": {
        "id": {"type": "string", "pattern": "^capability-family\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "definitionEn": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "familyId",
        "definitionEn",
        "prerequisiteCapabilityIds",
        "contextRequirement",
        "requiredCanonicalContextDimensionIds",
        "mechanicShape",
        "evidenceCeiling"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^capability\\.[a-z0-9.-]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "familyId": {"type": "string", "pattern": "^capability-family\\.[a-z0-9.-]+$"},
        "definitionEn": {"type": "string", "minLength": 1},
        "prerequisiteCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^capability\\.[a-z0-9.-]+$"}
        },
        "contextRequirement": {"enum": ["required", "recommended", "none"]},
        "requiredCanonicalContextDimensionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        },
        "mechanicShape": {"$ref": "#/$defs/mechanicShape"},
        "evidenceCeiling": {"$ref": "#/$defs/evidenceCeiling"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mechanicShape": {
                "properties": {
                  "candidateVisibility": {"const": "target-language-options-visible"}
                },
                "required": ["candidateVisibility"]
              }
            }
          },
          "then": {
            "properties": {
              "mechanicShape": {
                "properties": {
                  "operation": {"const": "discriminate"},
                  "responseMode": {"const": "closed-choice"},
                  "targetLanguageProduction": {"const": false}
                }
              },
              "evidenceCeiling": {
                "properties": {
                  "learningStage": {"const": "discriminate"},
                  "evidenceKind": {"const": "comprehension"},
                  "masteryEligible": {"const": false}
                }
              }
            }
          }
        }
      ]
    },
    "mechanicShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "responseMode", "candidateVisibility", "targetLanguageProduction"],
      "properties": {
        "operation": {"enum": ["interpret", "discriminate", "retrieve", "produce", "respond"]},
        "responseMode": {"enum": ["presentation", "closed-choice", "constructed-form", "complete-message", "interaction"]},
        "candidateVisibility": {"enum": ["target-language-options-visible", "support-only", "none"]},
        "targetLanguageProduction": {"type": "boolean"}
      }
    },
    "evidenceCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningStage",
        "evidenceKind",
        "maximumIndependence",
        "scoreRequired",
        "masteryEligible"
      ],
      "properties": {
        "learningStage": {
          "enum": [
            "encounter",
            "comprehend",
            "discriminate",
            "retrieve",
            "supported-produce",
            "interact",
            "transfer",
            "delayed-retrieval"
          ]
        },
        "evidenceKind": {"enum": ["exposure", "comprehension", "retrieval", "production", "transfer"]},
        "maximumIndependence": {"enum": ["exposure", "supported", "independent"]},
        "scoreRequired": {"type": "boolean"},
        "masteryEligible": {"type": "boolean"}
      }
    }
  }
}
