{
  "schemaVersion": "caatuu-canonical-curriculum-v1",
  "curriculumId": "caatuu.shared-beginner",
  "version": "1.0.0",
  "specLocale": "en",
  "title": "Caatuu Shared Beginner Curriculum",
  "description": "One canonical English-authored learning sequence implemented by every target language.",
  "planningPolicy": {
    "maxNewSemanticConceptsPerSession": 2,
    "maxNewTargetConstructionsPerSession": 1,
    "repairRetryTaskGap": {
      "minimum": 2,
      "maximum": 4
    },
    "delayedRetrievalMinimumSessionGap": 1,
    "exposureCanQualifyForMastery": false,
    "solutionRevealCanQualifyForMastery": false
  },
  "learningStageSequence": [
    "encounter",
    "comprehend",
    "discriminate",
    "retrieve",
    "supported-produce",
    "interact",
    "transfer",
    "delayed-retrieval"
  ],
  "semanticDefinitions": [
    {"id": "function.greet", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Initiate a social encounter with a greeting appropriate to the context."},
    {"id": "function.respond-to-greeting", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Acknowledge another person's greeting with an appropriate greeting response."},
    {"id": "function.identify-self", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "State one's own name or simple identity."},
    {"id": "function.affirm", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Give a simple affirmative response."},
    {"id": "function.reject", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Give a simple negative response."},
    {"id": "function.request-help", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Signal a need for assistance in the interaction."},
    {"id": "function.request-repetition", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Ask an interlocutor to repeat a message that was not understood."},
    {"id": "function.state-possession", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "State possession of a familiar item."},
    {"id": "function.state-want", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "State a simple immediate want."},
    {"id": "function.state-need", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "State a simple immediate need."},
    {"id": "function.state-like", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Express liking for a familiar item or activity."},
    {"id": "function.understand-simple-choice", "revision": 1, "kind": "function", "requiredEvidenceMode": "comprehension", "definitionEn": "Interpret a choice between two familiar alternatives."},
    {"id": "function.respond-simple-choice", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Select and communicate one of two familiar alternatives."},
    {"id": "function.describe-action", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Give a short statement describing a familiar person's current or habitual action."},
    {"id": "function.understand-action-question", "revision": 1, "kind": "function", "requiredEvidenceMode": "comprehension", "definitionEn": "Interpret a simple question about what a familiar person is doing or habitually does."},
    {"id": "function.affirm-action", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Confirm that a familiar action is taking place or is habitual."},
    {"id": "function.reject-action", "revision": 1, "kind": "function", "requiredEvidenceMode": "production", "definitionEn": "Deny that a familiar action is taking place or is habitual."},

    {"id": "frame.social.greeting", "revision": 1, "kind": "frame", "definitionEn": "A social opening between a greeter and an addressee."},
    {"id": "frame.identity.self", "revision": 1, "kind": "frame", "definitionEn": "A speaker supplies their own simple identity."},
    {"id": "frame.polarity.response", "revision": 1, "kind": "frame", "definitionEn": "A response selects affirmative or negative polarity."},
    {"id": "frame.interaction.repair", "revision": 1, "kind": "frame", "definitionEn": "A speaker signals a communication problem and requests repair."},
    {"id": "frame.possess", "revision": 1, "kind": "frame", "definitionEn": "A possessor is related to a possessed familiar item."},
    {"id": "frame.want", "revision": 1, "kind": "frame", "definitionEn": "An experiencer expresses a wanted familiar item or outcome."},
    {"id": "frame.need", "revision": 1, "kind": "frame", "definitionEn": "An experiencer expresses a needed familiar item or assistance."},
    {"id": "frame.like", "revision": 1, "kind": "frame", "definitionEn": "An experiencer expresses a positive preference for a familiar referent."},
    {"id": "frame.simple-choice", "revision": 1, "kind": "frame", "definitionEn": "A prompt presents two alternatives and a response selects one."},
    {"id": "frame.action", "revision": 1, "kind": "frame", "definitionEn": "An agent performs a familiar action, optionally involving an item or setting."},
    {"id": "frame.action-question", "revision": 1, "kind": "frame", "definitionEn": "A question requests identification of a familiar person's action."},
    {"id": "frame.action-polarity", "revision": 1, "kind": "frame", "definitionEn": "A response confirms or denies a proposed familiar action."},

    {"id": "concept.person.self", "revision": 1, "kind": "concept", "definitionEn": "The current speaker as a participant or experiencer."},
    {"id": "concept.person.other", "revision": 1, "kind": "concept", "definitionEn": "A person other than the current speaker."},
    {"id": "concept.polarity.yes", "revision": 1, "kind": "concept", "definitionEn": "Affirmative polarity."},
    {"id": "concept.polarity.no", "revision": 1, "kind": "concept", "definitionEn": "Negative polarity."},
    {"id": "concept.assistance", "revision": 1, "kind": "concept", "definitionEn": "Help supplied to resolve a practical or communication need."},
    {"id": "concept.repetition", "revision": 1, "kind": "concept", "definitionEn": "A message is produced again to support understanding."},
    {"id": "concept.familiar-item", "revision": 1, "kind": "concept", "definitionEn": "An everyday object already familiar to the learner."},
    {"id": "concept.food", "revision": 1, "kind": "concept", "definitionEn": "A familiar item that can be eaten."},
    {"id": "concept.drink", "revision": 1, "kind": "concept", "definitionEn": "A familiar item that can be drunk."},
    {"id": "concept.action.eat", "revision": 1, "kind": "concept", "definitionEn": "The familiar action of eating."},
    {"id": "concept.action.drink", "revision": 1, "kind": "concept", "definitionEn": "The familiar action of drinking."},
    {"id": "concept.action.sleep", "revision": 1, "kind": "concept", "definitionEn": "The familiar action of sleeping."},
    {"id": "concept.action.read", "revision": 1, "kind": "concept", "definitionEn": "The familiar action of reading."},
    {"id": "concept.action.play", "revision": 1, "kind": "concept", "definitionEn": "The familiar action of playing."}
  ],
  "unitOrder": [
    "unit.interaction.entry-and-repair.01",
    "unit.needs.possession-and-choice.01",
    "unit.routine.familiar-actions.01"
  ],
