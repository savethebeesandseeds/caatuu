{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/embedding-runtime-catalog.v1.schema.json",
  "title": "Caatuu shared embedding runtimes",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runtimes"],
  "properties": {
    "$schema": { "const": "https://caatuu.org/schemas/embedding-runtime-catalog.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtime" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "inputLanguage", "source", "embedding", "runtime", "artifacts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "status": { "const": "active" },
        "inputLanguage": { "const": "en" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "revision", "url", "license"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "url": { "type": "string", "pattern": "^https://" },
            "license": { "type": "string", "minLength": 1 }
          }
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimension", "distanceMetric", "pooling", "normalized"],
          "properties": {
            "dimension": { "type": "integer", "minimum": 1 },
            "distanceMetric": { "const": "cosine" },
            "pooling": { "const": "mean" },
            "normalized": { "const": true }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transformersModuleUrl",
            "localModelPath",
            "modelId",
            "modelFileName",
            "ortWasmModuleUrl",
            "ortWasmBinaryUrl"
          ],
          "properties": {
            "transformersModuleUrl": { "type": "string", "pattern": "^/language-runtime/vendor/transformers/" },
            "localModelPath": { "const": "/language-runtime/models/" },
            "modelId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*/runtime$" },
            "modelFileName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "ortWasmModuleUrl": { "type": "string", "pattern": "^/language-runtime/models/.+\\.mjs$" },
            "ortWasmBinaryUrl": { "type": "string", "pattern": "^/language-runtime/models/.+\\.wasm$" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "url", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?:vendor/transformers|models/[A-Za-z0-9._-]+/runtime)/[A-Za-z0-9._/-]+$" },
              "url": { "type": "string", "pattern": "^/language-runtime/(?:vendor/transformers|models/)[A-Za-z0-9._/-]+$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
