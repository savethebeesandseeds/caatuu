{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/course-pack.v1.schema.json",
  "title": "Caatuu course pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "directoryName",
    "status",
    "brandLabel",
    "workspaceLabel",
    "routePrefix",
    "entryPath",
    "sourceLanguage",
    "targetLanguage",
    "launcher",
    "routes",
    "storage",
    "cache",
    "publication",
    "capabilities",
    "skillCompass",
    "platforms",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "course-pack\\.v1\\.schema\\.json$"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/courseId"
    },
    "directoryName": {
      "$ref": "#/$defs/courseId"
    },
    "status": {
      "enum": ["development", "active", "retired"]
    },
    "brandLabel": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "workspaceLabel": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "routePrefix": {
      "$ref": "#/$defs/routePrefix"
    },
    "entryPath": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sourceLanguage": {
      "$ref": "#/$defs/sourceLanguage"
    },
    "targetLanguage": {
      "$ref": "#/$defs/targetLanguage"
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flagClass"],
      "properties": {
        "flagClass": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/courseRoute"
      },
      "required": ["languageSelection", "home", "games", "settings"],
      "properties": {
        "languageSelection": {
          "const": "/"
        }
      }
    },
    "storage": {
      "type": "object",
      "minProperties": 2,
      "required": ["namespace", "theme", "fontSize", "learningPreferences", "learningPerformance"],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^caatuu-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "setupFallback"],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "setupFallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "skillCompass": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/skillCompass" }
      ]
    },
    "linguisticFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["verb-conjugation", "grammatical-case", "grammatical-agreement", "hanzi-pinyin"]
      }
    },
    "games": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "campaign",
          "verb-lab",
          "word-net",
          "conjugation-comet",
          "case-cosmos",
          "agreement-aurora",
          "naturalization-nucleus",
          "memory-moon",
          "sound-quasar"
        ]
      }
    },
    "upcomingGames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "verb-lab",
          "word-net",
          "conjugation-comet",
          "case-cosmos",
          "agreement-aurora",
          "naturalization-nucleus",
          "memory-moon",
          "sound-quasar"
        ]
      }
    },
    "platforms": {
      "$ref": "#/$defs/platforms"
    },
    "resources": {
      "type": "object",
      "properties": {
        "dictionaryProvider": { "$ref": "#/$defs/dictionaryProviderResource" }
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "verb-lab" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["verbNebulaCatalog"],
            "properties": {
              "verbNebulaCatalog": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "word-net" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["wordWorldManifest"],
            "properties": {
              "wordWorldManifest": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "conjugation-comet" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["conjugationCometCatalog"],
            "properties": {
              "conjugationCometCatalog": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "case-cosmos" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["caseCosmosCatalog"],
            "properties": {
              "caseCosmosCatalog": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "agreement-aurora" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "properties": {
          "resources": {
            "required": ["agreementAuroraCatalog"],
            "properties": {
              "agreementAuroraCatalog": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "linguisticFeatures": {
            "contains": { "const": "hanzi-pinyin" }
          }
        },
        "required": ["linguisticFeatures"]
      },
      "then": {
        "properties": {
          "targetLanguage": {
            "properties": {
              "id": { "const": "zh" }
            },
            "required": ["id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "games": {
            "contains": { "const": "naturalization-nucleus" }
          }
        },
        "required": ["games"]
      },
      "then": {
        "required": ["linguisticFeatures", "resources"],
        "properties": {
          "linguisticFeatures": {
            "contains": { "const": "hanzi-pinyin" }
          },
          "resources": {
            "required": ["naturalizationNucleusCatalog"],
            "properties": {
              "naturalizationNucleusCatalog": { "$ref": "#/$defs/presentCourseFileResource" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "dictionary": { "const": true }
            },
            "required": ["dictionary"]
          }
        },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["resources"],
        "properties": {
          "resources": {
            "required": [
              "dictionaryCatalog",
              "dictionaryCoreEntries",
              "dictionaryScriptLines",
              "dictionaryReferenceDocument",
              "dictionaryProvider"
            ],
            "properties": {
              "dictionaryCatalog": { "$ref": "#/$defs/presentCourseDataFileResource" },
              "dictionaryCoreEntries": { "$ref": "#/$defs/presentCourseDataFileResource" },
              "dictionaryScriptLines": { "$ref": "#/$defs/presentCourseDataFileResource" },
              "dictionaryReferenceDocument": {
                "allOf": [
                  { "$ref": "#/$defs/resource" },
                  {
                    "properties": {
                      "kind": { "const": "file" },
                      "path": {
                        "pattern": "^apps/languages/[a-z0-9]+(?:-[a-z0-9]+)*/static/data/[A-Za-z0-9._/-]+\\.html$"
                      },
                      "scope": { "const": "course" },
                      "state": { "const": "present" }
                    }
                  }
                ]
              },
              "dictionaryProvider": {
                "$ref": "#/$defs/dictionaryProviderResource"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "skillCompass": { "const": true }
            },
            "required": ["skillCompass"]
          }
        },
        "required": ["capabilities"]
      },
      "then": {
        "properties": {
          "skillCompass": { "$ref": "#/$defs/skillCompass" }
        }
      },
      "else": {
        "properties": {
          "skillCompass": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "active" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "browser": {
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "retired" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "browser": {
                "properties": {
                  "enabled": { "const": false }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platforms": {
            "properties": {
              "browser": {
                "properties": {
                  "enabled": { "const": true }
                },
                "required": ["enabled"]
              }
            },
            "required": ["browser"]
          }
        },
        "required": ["platforms"]
      },
      "then": {
        "required": ["linguisticFeatures", "games"],
        "properties": {
          "resources": {
            "required": ["staticRoot", "appEntry"],
            "properties": {
              "staticRoot": {
                "properties": {
                  "kind": { "const": "directory" },
                  "scope": { "const": "course" },
                  "state": { "const": "present" }
                }
              },
              "appEntry": {
                "properties": {
                  "kind": { "const": "file" },
                  "path": { "const": "apps/language-runtime/static/app/index.html" },
                  "scope": { "const": "shared" },
                  "state": { "const": "present" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "routePrefix": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "courseRoute": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@/?%-]+)?$"
        },
        {
          "pattern": "^/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "concepts", "realizations", "learnerBaseRealizations", "runtimeProjection"],
      "properties": {
        "contract": {
          "enum": ["legacy-active-v1", "language-content-v1"]
        },
        "concepts": {
          "type": ["string", "null"]
        },
        "realizations": {
          "type": ["string", "null"]
        },
        "learnerBaseRealizations": {
          "type": ["string", "null"]
        },
        "runtimeProjection": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/wordWorldRuntimeProjection" }
          ]
        }
      }
    },
    "wordWorldRuntimeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "conceptsRuntime",
        "targetRealizationsRuntime",
        "learnerBaseRuntime",
        "supplementalOutputs",
        "manifest"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
        },
        "conceptsRuntime": { "type": "string", "minLength": 1 },
        "targetRealizationsRuntime": { "type": "string", "minLength": 1 },
        "learnerBaseRuntime": { "type": ["string", "null"] },
        "supplementalOutputs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*Projection$"
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "manifest": { "type": "string", "minLength": 1 }
      }
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "sourceLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "nativeLabel",
        "shortCode",
        "locale",
        "direction",
        "flagClass",
        "flagSrc"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nativeLabel": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "shortCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}$"
        },
        "locale": {
          "$ref": "#/$defs/languageTag"
        },
        "direction": {
          "enum": ["ltr", "rtl"]
        },
        "flagClass": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "flagSrc": {
          "type": "string",
          "pattern": "^/assets/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        }
      }
    },
    "targetLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "nativeLabel",
        "shortCode",
        "locale",
        "script",
        "speechLocale",
        "direction",
        "flagClass",
        "flagSrc"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nativeLabel": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "shortCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}$"
        },
        "locale": {
          "$ref": "#/$defs/languageTag"
        },
        "script": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$"
        },
        "speechLocale": {
          "$ref": "#/$defs/languageTag"
        },
        "direction": {
          "enum": ["ltr", "rtl"]
        },
        "flagClass": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "flagSrc": {
          "type": "string",
          "pattern": "^/assets/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llm",
        "generation",
        "chat",
        "embeddings",
        "semanticSearch",
        "skillCompass",
        "dictionary",
        "memory",
        "verbs",
        "wordWorld",
        "conjugationComet",
        "offlineModels",
        "speech",
        "pronunciationGuides"
      ],
      "properties": {
        "llm": { "type": "boolean" },
        "generation": { "type": "boolean" },
        "chat": { "type": "boolean" },
        "embeddings": { "type": "boolean" },
        "semanticSearch": { "type": "boolean" },
        "skillCompass": { "type": "boolean" },
        "dictionary": { "type": "boolean" },
        "memory": { "type": "boolean" },
        "verbs": { "type": "boolean" },
        "wordWorld": { "type": "boolean" },
        "conjugationComet": { "type": "boolean" },
        "offlineModels": { "type": "boolean" },
        "speech": { "type": "boolean" },
        "pronunciationGuides": { "type": "boolean" }
      }
    },
    "skillCompass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "modelId", "minimumConfidence", "copy", "axes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "modelId": { "$ref": "#/$defs/nonEmptyString" },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "summary",
            "chartTitle",
            "chartDescription",
            "legendLabel",
            "practiceLabel",
            "strengthLabel",
            "confidenceLabel",
            "progressLabel",
            "notMapped",
            "building",
            "notAssessed",
            "idleMessage",
            "emptyChartDescription",
            "emptyMessage",
            "emptySummary",
            "projectionDescription",
            "unmappedMessage",
            "practiceOnlyMessage",
            "partialStrengthMessage",
            "completeMessage",
            "loadingMessage",
            "loadingSummary",
            "errorMessage",
            "errorSummary",
            "changedMessage",
            "closedMessage",
            "updateReadySummary",
            "closedSummary"
          ],
          "properties": {
            "eyebrow": { "$ref": "#/$defs/nonEmptyString" },
            "title": { "$ref": "#/$defs/nonEmptyString" },
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "chartTitle": { "$ref": "#/$defs/nonEmptyString" },
            "chartDescription": { "$ref": "#/$defs/nonEmptyString" },
            "legendLabel": { "$ref": "#/$defs/nonEmptyString" },
            "practiceLabel": { "$ref": "#/$defs/nonEmptyString" },
            "strengthLabel": { "$ref": "#/$defs/nonEmptyString" },
            "confidenceLabel": { "$ref": "#/$defs/nonEmptyString" },
            "progressLabel": { "$ref": "#/$defs/nonEmptyString" },
            "notMapped": { "$ref": "#/$defs/nonEmptyString" },
            "building": { "$ref": "#/$defs/nonEmptyString" },
            "notAssessed": { "$ref": "#/$defs/nonEmptyString" },
            "idleMessage": { "$ref": "#/$defs/nonEmptyString" },
            "emptyChartDescription": { "$ref": "#/$defs/nonEmptyString" },
            "emptyMessage": { "$ref": "#/$defs/nonEmptyString" },
            "emptySummary": { "$ref": "#/$defs/nonEmptyString" },
            "projectionDescription": { "$ref": "#/$defs/nonEmptyString" },
            "unmappedMessage": { "$ref": "#/$defs/nonEmptyString" },
            "practiceOnlyMessage": { "$ref": "#/$defs/nonEmptyString" },
            "partialStrengthMessage": { "$ref": "#/$defs/nonEmptyString" },
            "completeMessage": { "$ref": "#/$defs/nonEmptyString" },
            "loadingMessage": { "$ref": "#/$defs/nonEmptyString" },
            "loadingSummary": { "$ref": "#/$defs/nonEmptyString" },
            "errorMessage": { "$ref": "#/$defs/nonEmptyString" },
            "errorSummary": { "$ref": "#/$defs/nonEmptyString" },
            "changedMessage": { "$ref": "#/$defs/nonEmptyString" },
            "closedMessage": { "$ref": "#/$defs/nonEmptyString" },
            "updateReadySummary": { "$ref": "#/$defs/nonEmptyString" },
            "closedSummary": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "axes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "chartLabel", "emblem", "probe"],
            "properties": {
              "id": { "$ref": "#/$defs/courseId" },
              "label": { "$ref": "#/$defs/nonEmptyString" },
              "chartLabel": { "$ref": "#/$defs/nonEmptyString" },
              "chartLabelBelow": { "type": "boolean" },
              "emblem": {
                "enum": ["people", "home", "food", "journey", "actions", "time", "world"]
              },
              "probe": {
                "type": "object",
                "additionalProperties": false,
                "required": ["locale", "revision", "text"],
                "properties": {
                  "locale": { "$ref": "#/$defs/languageTag" },
                  "revision": { "$ref": "#/$defs/nonEmptyString" },
                  "text": { "$ref": "#/$defs/nonEmptyString" }
                }
              }
            }
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "android"],
      "properties": {
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "pagesEnabled", "entryPath", "backend"],
          "properties": {
            "enabled": { "type": "boolean" },
            "pagesEnabled": { "type": "boolean" },
            "entryPath": {
              "type": "string",
              "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*/[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "backend": {
              "enum": ["static", "dictionary-api-v1"]
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "channels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "manifest", "artifact", "minimumVersionCode"],
                "properties": {
                  "kind": {
                    "enum": ["release", "preview", "debug"]
                  },
                  "manifest": {
                    "type": "string",
                    "pattern": "^/android/[A-Za-z0-9][A-Za-z0-9._/-]*$"
                  },
                  "artifact": {
                    "type": "string",
                    "pattern": "^/android/[A-Za-z0-9][A-Za-z0-9._/-]*$"
                  },
                  "minimumVersionCode": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "presentCourseFileResource": {
      "allOf": [
        { "$ref": "#/$defs/resource" },
        {
          "properties": {
            "kind": { "const": "file" },
            "path": {
              "pattern": "^apps/languages/[a-z0-9]+(?:-[a-z0-9]+)*/static/data/games/[A-Za-z0-9._/-]+\\.json$"
            },
            "scope": { "const": "course" },
            "state": { "const": "present" }
          }
        }
      ]
    },
    "presentCourseDataFileResource": {
      "allOf": [
        { "$ref": "#/$defs/resource" },
        {
          "properties": {
