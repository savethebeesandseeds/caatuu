{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/language-catalog.v1.schema.json",
  "title": "Caatuu internal language catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "defaultCourseId",
    "reservedRoutePrefixes",
    "courses"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "catalog\\.v1\\.schema\\.json$"
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultCourseId": {
      "$ref": "#/$defs/courseId"
    },
    "reservedRoutePrefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/routePrefix"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest"],
        "properties": {
          "id": {
            "$ref": "#/$defs/courseId"
          },
          "manifest": {
            "type": "string",
            "pattern": "^apps/languages/[a-z0-9]+(?:-[a-z0-9]+)*/course\\.json$"
          }
        }
      }
    }
  },
  "$defs": {
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "routePrefix": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
