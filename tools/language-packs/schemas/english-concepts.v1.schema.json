{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/english-concepts.v1.schema.json",
  "title": "Caatuu English concept catalog v1",
  "description": "Language-neutral learning concepts whose embedding input is authored English only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "language",
    "embeddingPolicy",
    "license",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "english-concepts\\.v1\\.schema\\.json$"
    },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/catalogId" },
    "language": { "const": "en" },
    "embeddingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputLanguage", "inputField", "targetTextAllowed"],
      "properties": {
        "inputLanguage": { "const": "en" },
        "inputField": { "const": "embeddingText" },
        "targetTextAllowed": { "const": false }
      }
    },
    "license": { "$ref": "#/$defs/licenseGate" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-v[1-9][0-9]*$"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "licenseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "status",
        "spdxExpression",
        "sourceReference",
        "reviewedBy",
        "reviewedAt"
      ],
      "properties": {
        "origin": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "enum": ["release-review-required", "release-cleared"]
        },
        "spdxExpression": {
          "type": ["string", "null"]
        },
        "sourceReference": {
          "type": ["string", "null"]
        },
        "reviewedBy": {
          "type": ["string", "null"]
        },
        "reviewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "englishText",
        "embeddingText",
        "sceneQuery",
        "topic",
        "difficulty"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/conceptId" },
        "englishText": { "$ref": "#/$defs/nonEmptyString" },
        "embeddingText": { "$ref": "#/$defs/nonEmptyString" },
        "sceneQuery": { "$ref": "#/$defs/nonEmptyString" },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
