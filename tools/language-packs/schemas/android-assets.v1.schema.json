{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caatuu.org/schemas/android-assets.v1.schema.json",
  "title": "Caatuu Android course asset catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "courseId",
    "nativeProviders",
    "files",
    "launcherIconFiles"
  ],
  "properties": {
    "$schema": { "const": "https://caatuu.org/schemas/android-assets.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "courseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "enabled": { "type": "boolean" },
    "nativeProviders": { "$ref": "#/$defs/nativeProviders" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assetPath" }
    },
    "sharedRuntimeFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assetPath" }
    },
    "launcherIconFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assetPath" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeOnlyAllowlistedFiles",
        "llmAssetsAllowed",
        "targetPronunciationMetadataAllowed"
      ],
      "properties": {
        "includeOnlyAllowlistedFiles": { "const": true },
        "llmAssetsAllowed": { "type": "boolean" },
        "targetPronunciationMetadataAllowed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "assetPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
    },
    "nativeProviders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "providers"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embeddings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["implementation", "resource"],
              "properties": {
                "implementation": { "const": "vector-database-catalog-v1" },
                "resource": { "const": "embeddingCatalog" }
              }
            },
            "dictionary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["implementation", "resource"],
              "properties": {
                "implementation": { "const": "sqlite-dictionary-catalog-v1" },
                "resource": { "const": "dictionaryCatalog" }
              }
            },
            "speech": {
              "type": "object",
              "additionalProperties": false,
              "required": ["implementation", "localeSource"],
              "properties": {
                "implementation": { "const": "android-text-to-speech-v1" },
                "localeSource": { "const": "targetLanguage.speechLocale" }
              }
            }
          }
        }
      }
    }
  }
}
